package views

import "github.com/edlingao/hexago/web/templates"

type IndexVM struct {
	Error error
}

templ Index(vm IndexVM) {
	@templates.Index(templates.IndexVM{Title: "Hedgestone Carwash", Error: vm.Error}) {
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@0..1&display=swap" rel="stylesheet"/>

		<div class="min-h-screen bg-white" x-data="landingStore()" x-init="init()">
			@PublicNavbar()

			<!-- Hero -->
			<section class="bg-white">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
						<div>
							<p class="inline-flex items-center gap-2 text-xs font-semibold tracking-wider uppercase text-slate-500">
								<span class="h-2 w-2 rounded-full bg-blue-600"></span>
								Premium carwash membership
							</p>

							<h1 class="mt-4 text-5xl md:text-6xl font-black tracking-tight text-slate-900 leading-[1.05]">
								Effortless Shine,
								<span class="block text-slate-400">Every Time</span>
							</h1>

							<p class="mt-5 text-slate-600 max-w-xl">
								Experience premium car wash services with unlimited monthly plans. Drive clean, drive confident.
							</p>

							<div class="mt-8 flex flex-wrap gap-3">
								<button @click="goToPricing()" class="rounded-full bg-black text-white px-6 py-3 font-semibold hover:bg-slate-900">
									Choose Your Plan
								</button>
								<a href="/about" class="rounded-full bg-white border border-slate-200 text-slate-900 px-6 py-3 font-semibold hover:bg-slate-50">
									Learn More
								</a>
							</div>

							<div class="mt-10 flex gap-10">
								<div>
									<p class="text-2xl font-black text-slate-900">50K+</p>
									<p class="text-xs text-slate-500">Happy Members</p>
								</div>
								<div>
									<p class="text-2xl font-black text-slate-900" x-text="locations.length ? locations.length : '—'"></p>
									<p class="text-xs text-slate-500">Locations</p>
								</div>
								<div>
									<p class="text-2xl font-black text-slate-900">4.9</p>
									<p class="text-xs text-slate-500">Rating</p>
								</div>
							</div>
						</div>

						<div class="relative">
							<div class="rounded-3xl bg-slate-100 p-4 shadow-xl border border-slate-200">
								<img src="/static/hero.png" alt="Carwash hero" class="w-full h-[420px] object-cover rounded-2xl"/>
							</div>
							<div class="absolute -bottom-6 -left-6 h-28 w-28 rounded-3xl bg-blue-600/10 blur-2xl"></div>
							<div class="absolute -top-6 -right-6 h-28 w-28 rounded-3xl bg-black/10 blur-2xl"></div>
						</div>
					</div>
				</div>
			</section>

			<!-- Features -->
			<section id="features" class="bg-slate-50 border-t border-slate-200">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
					<div class="text-center">
						<h2 class="text-3xl md:text-4xl font-black text-slate-900">Why Choose Hedgestone</h2>
						<p class="mt-3 text-slate-600">Premium services designed for the modern driver</p>
					</div>

					<div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-6">
						<div class="rounded-2xl bg-white border border-slate-200 p-6">
							<div class="h-10 w-10 rounded-full bg-black text-white flex items-center justify-center">
								<span class="material-symbols-outlined">all_inclusive</span>
							</div>
							<h3 class="mt-4 font-bold text-slate-900">Unlimited Washes</h3>
							<p class="mt-2 text-sm text-slate-600">Wash as often as you like with no additional charges.</p>
						</div>

						<div class="rounded-2xl bg-white border border-slate-200 p-6">
							<div class="h-10 w-10 rounded-full bg-black text-white flex items-center justify-center">
								<span class="material-symbols-outlined">bolt</span>
							</div>
							<h3 class="mt-4 font-bold text-slate-900">Express Service</h3>
							<p class="mt-2 text-sm text-slate-600">In and out fast. Premium quality without the wait.</p>
						</div>

						<div class="rounded-2xl bg-white border border-slate-200 p-6">
							<div class="h-10 w-10 rounded-full bg-black text-white flex items-center justify-center">
								<span class="material-symbols-outlined">eco</span>
							</div>
							<h3 class="mt-4 font-bold text-slate-900">Eco-Friendly</h3>
							<p class="mt-2 text-sm text-slate-600">Water-conscious process and cleaner products.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Pricing (DB-backed) -->
			<section id="pricing" class="bg-white border-t border-slate-200">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
					<div class="text-center">
						<h2 class="text-3xl md:text-4xl font-black text-slate-900">Simple, Transparent Pricing</h2>
						<p class="mt-3 text-slate-600">Plans are loaded live from the database</p>
					</div>

					<div x-show="errorPlans" x-cloak class="mt-6 max-w-2xl mx-auto p-4 bg-red-50 border border-red-200 text-red-700 rounded-xl" x-text="errorPlans"></div>

					<div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-6">
						<template x-for="p in plans" :key="p.id">
							<div class="rounded-2xl border border-slate-200 shadow-sm p-6 flex flex-col"
								:class="p.id === featuredPlanId ? 'bg-black text-white' : 'bg-white text-slate-900'">
								<div class="flex items-center justify-between">
									<h3 class="text-xl font-black" x-text="p.name"></h3>
									<span x-show="p.id === featuredPlanId" x-cloak class="text-xs font-semibold px-3 py-1 rounded-full bg-white/10 border border-white/20">
										Most Popular
									</span>
								</div>

								<div class="mt-3 flex items-end gap-2">
									<p class="text-5xl font-black" x-text="priceLabel(p.priceCents)"></p>
									<p class="text-sm opacity-80">/month</p>
								</div>

								<ul class="mt-6 space-y-3 text-sm" :class="p.id === featuredPlanId ? 'text-white/90' : 'text-slate-600'">
									<template x-for="f in (p.features || []).slice(0, 6)" :key="f">
										<li class="flex items-start gap-2">
											<span class="material-symbols-outlined text-base" :class="p.id === featuredPlanId ? 'text-blue-300' : 'text-blue-600'">check_circle</span>
											<span x-text="f"></span>
										</li>
									</template>
								</ul>

								<div class="mt-auto pt-8">
									<button @click="selectPlan(p.id)"
										class="w-full rounded-full px-5 py-3 font-bold"
										:class="p.id === featuredPlanId ? 'bg-white text-black hover:bg-slate-100' : 'bg-white border border-slate-200 hover:bg-slate-50'">
										Select Plan
									</button>
								</div>
							</div>
						</template>
					</div>
				</div>
			</section>

			<!-- How it works -->
			<section class="bg-slate-50 border-t border-slate-200">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
					<div class="text-center">
						<h2 class="text-3xl md:text-4xl font-black text-slate-900">How It Works</h2>
						<p class="mt-3 text-slate-600">Get started in three simple steps</p>
					</div>

					<div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-6">
						<div class="rounded-2xl bg-white border border-slate-200 p-6 text-center">
							<div class="mx-auto h-12 w-12 rounded-full bg-black text-white flex items-center justify-center font-black">1</div>
							<h3 class="mt-4 font-bold text-slate-900">Choose Your Plan</h3>
							<p class="mt-2 text-sm text-slate-600">Select a subscription that matches your needs.</p>
						</div>
						<div class="rounded-2xl bg-white border border-slate-200 p-6 text-center">
							<div class="mx-auto h-12 w-12 rounded-full bg-black text-white flex items-center justify-center font-black">2</div>
							<h3 class="mt-4 font-bold text-slate-900">Get Your Code</h3>
							<p class="mt-2 text-sm text-slate-600">Your account generates a QR code for access.</p>
						</div>
						<div class="rounded-2xl bg-white border border-slate-200 p-6 text-center">
							<div class="mx-auto h-12 w-12 rounded-full bg-black text-white flex items-center justify-center font-black">3</div>
							<h3 class="mt-4 font-bold text-slate-900">Scan & Wash</h3>
							<p class="mt-2 text-sm text-slate-600">Scan at the entrance and wash unlimited.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Locations -->
			<section id="locations" class="bg-white border-t border-slate-200">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
					<div class="flex items-end justify-between gap-6 flex-wrap">
						<div>
							<h2 class="text-3xl md:text-4xl font-black text-slate-900">Locations</h2>
							<p class="mt-3 text-slate-600">Available locations loaded from the database</p>
						</div>
						<button @click="goToPricing()" class="rounded-full bg-black text-white px-6 py-3 font-semibold hover:bg-slate-900">
							Get Started
						</button>
					</div>

					<div x-show="errorLocations" x-cloak class="mt-6 p-4 bg-red-50 border border-red-200 text-red-700 rounded-xl" x-text="errorLocations"></div>

					<div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
						<template x-for="l in locations" :key="l.id">
							<div class="rounded-2xl border border-slate-200 p-6 bg-slate-50">
								<p class="font-bold text-slate-900" x-text="l.name"></p>
								<p class="mt-2 text-sm text-slate-600" x-text="l.address"></p>
							</div>
						</template>
					</div>
				</div>
			</section>

			@PublicFooter()
		</div>
	}
}
