package users

import "github.com/edlingao/hexago/web/templates"

type ChoosePlanVM struct{ Error error }

templ ChoosePlan(vm ChoosePlanVM) {
	@templates.Index(templates.IndexVM{Title: "Choose Plan - Hedgestone Carwash", Error: vm.Error}) {
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
		<div class="min-h-screen bg-slate-100 text-slate-900" x-data="choosePlanStore()" x-init="init()">
			("choose-plan")

			<main class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-8">
				<section class="mt-6">
					<div class="flex flex-col gap-2">
						<h1 class="text-4xl font-semibold tracking-tight text-slate-900">Choose your plan</h1>
						<p class="text-slate-500">Pick a subscription to activate your account.</p>
					</div>
				</section>

				<div x-show="error" x-cloak class="mt-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-red-800" x-text="error"></div>

				<div x-show="loading" x-cloak class="mt-8 text-slate-500">Loading…</div>

				<div x-show="!loading" x-cloak class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-6">
					<template x-for="p in plans" :key="p.id">
						<button
							type="button"
							class="text-left rounded-3xl bg-white border shadow-sm overflow-hidden transition hover:shadow-md focus:outline-none focus:ring-2 focus:ring-amber-500"
							:class="selectedPlanId === p.id ? 'border-amber-200 ring-2 ring-amber-500' : 'border-slate-200'"
							@click="selectPlan(p.id)"
						>
							<div class="p-6 sm:p-7 flex flex-col h-full">
								<div class="flex items-start justify-between gap-4">
									<div class="min-w-0">
										<div class="text-xl font-bold tracking-tight text-slate-900" x-text="p.name"></div>
										<div class="mt-1 text-sm text-slate-500">Unlimited access membership</div>
									</div>

									<div class="flex items-center gap-2 shrink-0">
										<span
											x-show="currentPlanId && p.id === currentPlanId && selectedPlanId !== p.id"
											x-cloak
											class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold border bg-slate-50 text-slate-700 border-slate-200"
										>Current</span>
										<span
											x-show="selectedPlanId === p.id"
											x-cloak
											class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold border bg-amber-50 text-amber-800 border-amber-200"
										>Selected</span>
									</div>
								</div>

								<div class="mt-6 flex items-end gap-2">
									<div class="text-4xl font-bold tracking-tight leading-none text-slate-900" x-text="formatPrice(p.priceCents)"></div>
									<div class="pb-1 text-slate-500 font-medium">/mo</div>
								</div>

								<div class="mt-6 space-y-3">
									<template x-for="f in (p.features || [])" :key="f">
										<div class="flex items-start gap-3 text-slate-700">
											<span class="material-symbols-outlined text-amber-600 text-xl">check_circle</span>
											<span class="leading-relaxed" x-text="f"></span>
										</div>
									</template>
								</div>

								<div class="mt-auto pt-8">
									<div
										class="h-11 w-full rounded-2xl flex items-center justify-center font-semibold transition-colors"
										:class="selectedPlanId === p.id ? 'bg-black text-white' : 'bg-white border border-slate-300 text-slate-900 hover:bg-slate-50'"
									>
										<span x-text="selectedPlanId === p.id ? 'Selected' : 'Select plan'"></span>
									</div>
								</div>
							</div>
						</button>
					</template>
				</div>

				<div class="mt-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
					<div class="text-slate-500 text-sm">
						Selected: <span class="font-semibold text-slate-900" x-text="selectedPlan?.name || '—'"></span>
					</div>

					<button
						class="h-11 px-7 rounded-2xl bg-black text-white font-black shadow-sm hover:bg-slate-900 disabled:opacity-60"
						:disabled="saving || !selectedPlanId"
						@click="save()"
					>
						<span x-text="saving ? 'Saving…' : 'Continue'"></span>
					</button>
				</div>
			</main>

			<style>
				[x-cloak] { display: none !important; }
			</style>
		</div>
	}
}
