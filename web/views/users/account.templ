package users

import . "github.com/edlingao/hexago/web/views"

type AccountVM struct {
	Error error
}

templ Account(vm AccountVM) {
	@UserShell(UserShellVM{Title: "Account - Hedgestone Carwash", Error: vm.Error}) {
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
		<script>
function myCarsStoreVIN(baseFactoryArg) {
  const baseFactory = (typeof baseFactoryArg === "function") ? baseFactoryArg : ((typeof window !== "undefined" && typeof window.myCarsStore === "function") ? window.myCarsStore : null);
  const base = baseFactory ? baseFactory() : {};
  const baseCloseModal = base.closeModal;

  return {
    ...base,

    vinScannerOpen: false,
    vinCandidate: "",
    vinScanError: "",

    vinStream: null,
    vinCameraError: "",

    vinScanTimer: null,
    openVINScanner() {
      this.vinScanError = "";
      this.vinCameraError = "";
      this.vinCandidate = ((this.form?.vin || "")).replace(/[^A-Za-z0-9]/g, "").toUpperCase();this.vinScannerOpen = true;
      this.$nextTick(() => this.startVINCamera());
    },

    closeVINScanner() {
      this.stopVINCamera();
      this.vinScannerOpen = false;
      this.vinScanError = "";
      this.vinCameraError = "";
    },

    async startVINCamera() {
      if (!this.vinScannerOpen) return;
      this.vinCameraError = "";
      this.vinScanError = "";
      try {
        if (!navigator?.mediaDevices?.getUserMedia) {
          this.vinCameraError = "Camera not supported in this browser.";
          return;
        }

        this.stopVINCamera();

        const stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: { ideal: "environment" } },
          audio: false,
        });

        this.vinStream = stream;

        const video = this.$refs?.vinVideo;
        if (!video) {
          this.vinCameraError = "Camera element not found.";
          this.stopVINCamera();
          return;
        }

        video.srcObject = stream;

        const playPromise = video.play();

        try { await playPromise; } catch (_) {}

        if (typeof window === "undefined" || typeof window.BarcodeDetector !== "function") {
          this.vinCameraError = "Barcode scanning is not supported in this browser.";
          return;
        }

        let formats = ["code_39", "code_128", "qr_code"];
        try {
          if (typeof BarcodeDetector.getSupportedFormats === "function") {
            const supported = await BarcodeDetector.getSupportedFormats();
            const preferred = ["code_39", "code_128", "qr_code", "data_matrix", "pdf417"];
            const filtered = preferred.filter(f => supported.includes(f));
            if (filtered.length) formats = filtered;
          }
        } catch (_) {}

        const detector = new BarcodeDetector({ formats });

        const tick = async () => {
          if (!this.vinScannerOpen || !this.vinStream) return;

          try {
            const codes = await detector.detect(video);
            if (codes && codes.length) {
              const raw = (codes[0] && (codes[0].rawValue || "")) || "";
              const vin = raw.replace(/[^A-Za-z0-9]/g, "").toUpperCase();
              if (vin.length === 17 && /^[A-HJ-NPR-Z0-9]{17}$/.test(vin)) {
                this.vinCandidate = vin;
                this.vinScanError = "";
                this.stopVINCamera();
                return;
              }
            }
} catch (_) {}

          this.vinScanTimer = setTimeout(tick, 250);
        };

        this.vinScanTimer = setTimeout(tick, 250);

        if (playPromise && typeof playPromise.then === "function") {
          await playPromise;
        }
      } catch (e) {
        this.vinCameraError = (e && e.message) ? e.message : "Could not access camera.";
        this.stopVINCamera();
      }
    },

    stopVINCamera() {
      if (this.vinScanTimer) {
        try { clearTimeout(this.vinScanTimer); } catch (_) {}
        this.vinScanTimer = null;
      }
      const video = this.$refs?.vinVideo;
      if (video && video.srcObject) {
        try { video.pause(); } catch (_) {}
        video.srcObject = null;
      }
      if (this.vinStream && this.vinStream.getTracks) {
        try { this.vinStream.getTracks().forEach(t => t.stop()); } catch (_) {}
      }
      this.vinStream = null;
    },


    confirmScannedVIN() {
      const raw = (this.vinCandidate || "");
      const v = raw.replace(/[^A-Za-z0-9]/g, "").toUpperCase();
      if (v.length !== 17 || !/^[A-HJ-NPR-Z0-9]{17}$/.test(v)) {
        this.vinScanError = "Please enter a valid 17-character VIN (letters/digits; no I, O, or Q).";
        return;
      }
      this.form.vin = v;
      this.closeVINScanner();
    },


    closeModal() {
      if (this.vinScannerOpen) this.closeVINScanner();
      if (typeof baseCloseModal === "function") return baseCloseModal.call(this);
    },
  };
}
</script>
<div class="min-h-screen bg-slate-100 text-slate-900 overflow-x-hidden" x-data="accountStore">
			<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-8">
				@DashboardHeader("account")

				<section class="mt-10">
					<div class="flex flex-col gap-2">
						<div class="text-4xl font-semibold tracking-tight">Account</div>
						<div class="text-slate-500">Manage your profile, subscription, and vehicles.</div>
					</div>
				</section>

				<div class="mt-8 grid grid-cols-1 lg:grid-cols-3 gap-6">
					<div class="lg:col-span-2 flex flex-col gap-6">
						<div class="rounded-3xl bg-white border border-slate-200 shadow-sm overflow-hidden">
							<div class="p-6 sm:p-8">
								<div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
									<div>
										<h2 class="text-2xl font-semibold tracking-tight text-slate-900">Profile</h2>
										<p class="mt-1 text-sm text-slate-500">Update your details and preferences.</p>
									</div>
									<div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
										<button @click="saveProfile()"
											class="w-full sm:w-auto h-11 px-5 rounded-2xl bg-black text-white font-semibold hover:bg-slate-900 transition-colors">
											Save changes
										</button>
										<button @click="resetForm()"
											class="w-full sm:w-auto h-11 px-5 rounded-2xl bg-white border border-slate-300 text-slate-900 font-semibold hover:bg-slate-50 transition-colors">
											Reset
										</button>
									</div>
								</div>

								<div class="mt-8 flex flex-col sm:flex-row sm:items-center gap-6">
									<div class="h-20 w-20 rounded-full border border-slate-200 bg-slate-100 bg-center bg-cover bg-no-repeat shrink-0"
										:style="avatarPreview ? `background-image: url('${avatarPreview}')` : (user?.avatarUrl ? `background-image: url('${user.avatarUrl}')` : '')"></div>

									<div class="min-w-0 w-full">
										<label class="text-slate-700 text-sm font-medium">Profile picture</label>
										<input type="file" accept="image/*" class="block mt-2 text-sm w-full max-w-full"
											@change="onAvatarChange($event)"/>
										<p class="text-slate-500 text-xs mt-1">PNG/JPG recommended. Stored locally for now.</p>
									</div>
								</div>

								<div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
									<div>
										<label class="text-slate-700 text-sm font-medium">First name</label>
										<input class="mt-1 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-slate-900"
											type="text" x-model="firstName"/>
									</div>
									<div>
										<label class="text-slate-700 text-sm font-medium">Last name</label>
										<input class="mt-1 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-slate-900"
											type="text" x-model="lastName"/>
									</div>
									<div class="sm:col-span-2">
										<label class="text-slate-700 text-sm font-medium">Email</label>
										<input class="mt-1 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-slate-900"
											type="email" x-model="email"/>
									</div>
								</div>

								<div x-show="error" x-cloak class="mt-5 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-red-800">
									<span x-text="error"></span>
								</div>

								<div x-show="saved" x-cloak class="mt-5 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-emerald-800">
									Saved.
								</div>
							</div>
						</div>

						<div class="rounded-3xl bg-white border border-slate-200 shadow-sm overflow-hidden" x-data="myCarsStoreVIN(myCarsStore)" x-init="init()">
							<div class="p-6 sm:p-8">
								<div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
									<div>
										<h2 class="text-2xl font-semibold tracking-tight text-slate-900">My Vehicles</h2>
										<p class="mt-1 text-sm text-slate-500">Add and manage the vehicles linked to your membership.</p>
									</div>
									<button class="w-full sm:w-auto h-11 px-5 rounded-2xl bg-black text-white font-semibold hover:bg-slate-900 transition-colors flex items-center justify-center gap-2"
										@click="openAdd()">
										<span class="material-symbols-outlined text-base">add</span>
										Add vehicle
									</button>
								</div>

								<div x-show="loading" class="mt-6 text-slate-500">Loading…</div>
								<div x-show="error" x-cloak class="mt-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-red-800" x-text="error"></div>

								<div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
									<template x-for="c in cars" :key="c.id">
										<div class="rounded-2xl border border-slate-200 p-5 flex flex-col gap-4">
											<div class="min-w-0">
												<p class="text-slate-900 font-semibold truncate" x-text="carTitle(c)"></p>
												<p class="text-slate-500 text-sm truncate" x-text="`${c.year || ''} ${(c.make || '')} ${(c.model || '')}`.trim()"></p>
												<p class="text-slate-500 text-xs mt-1" x-show="c.plate" x-text="`Plate: ${c.plate}`"></p>
												<p class="text-slate-500 text-xs" x-show="c.vin" x-text="`VIN: ${c.vin}`"></p>
											</div>

											<div class="flex flex-col sm:flex-row gap-2">
												<button class="w-full sm:w-auto h-10 px-4 rounded-2xl bg-white border border-slate-300 text-slate-900 font-semibold hover:bg-slate-50 transition-colors"
													@click="openEdit(c)">Edit</button>
												<button class="w-full sm:w-auto h-10 px-4 rounded-2xl bg-red-600 text-white font-semibold hover:bg-red-700 transition-colors"
													@click="remove(c.id)">Delete</button>
											</div>
										</div>
									</template>

									<div x-show="!loading && (!cars || cars.length === 0)" class="rounded-2xl border border-dashed border-slate-200 p-6 text-center text-slate-500">
										No vehicles yet. Click <span class="font-semibold">Add vehicle</span> to create one.
									</div>
								</div>

								<div x-show="modalOpen" x-cloak class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
									<div class="bg-white w-full max-w-lg rounded-3xl shadow-xl p-6 sm:p-8 max-h-[85vh] overflow-auto">
										<div class="flex items-center justify-between mb-4">
											<h3 class="text-lg font-bold text-slate-900" x-text="editingId ? 'Edit vehicle' : 'Add vehicle'"></h3>
											<button class="text-slate-500 hover:text-slate-900" @click="closeModal()">✕</button>
										</div>

										<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
											<div class="md:col-span-2">
												<label class="text-sm font-medium text-slate-700">Nickname (optional)</label>
												<input class="mt-1 w-full rounded-2xl border border-slate-200 px-4 py-3" x-model="form.nickname" placeholder="My SUV"/>
											</div>

											<div>
												<label class="text-sm font-medium text-slate-700">Year</label>
												<input class="mt-1 w-full rounded-2xl border border-slate-200 px-4 py-3"
													x-model="form.year" @input="onYearInput($event.target.value)" placeholder="2022"/>
											</div>

											<div>
<label class="text-sm font-medium text-slate-700">VIN (optional)</label>
<input class="mt-1 w-full rounded-2xl border border-slate-200 px-4 py-3"
x-model="form.vin" placeholder="17-char VIN"/>

<div class="mt-2 flex flex-wrap gap-2">
<button type="button"
class="h-10 px-4 rounded-2xl bg-white border border-slate-300 text-slate-900 font-semibold hover:bg-slate-50 disabled:opacity-60 flex items-center justify-center gap-2"
:disabled="vinScannerOpen"
@click="openVINScanner()">
<span class="material-symbols-outlined text-base">qr_code_scanner</span>
Scan VIN
</button>

<button class="h-10 px-4 rounded-2xl bg-white border border-slate-300 text-slate-900 font-semibold hover:bg-slate-50 disabled:opacity-60"
x-show="(form.vin || '').trim().length === 17"
:disabled="decodingVin"
@click="decodeVIN()">
<span x-text="decodingVin ? 'Decoding…' : 'Decode VIN'"></span>
</button>
</div>

<div x-show="vinScannerOpen" x-cloak class="mt-3 rounded-2xl border border-slate-200 bg-slate-50 p-3">
<div class="rounded-2xl overflow-hidden bg-black">
<video x-ref="vinVideo" class="w-full h-52 object-cover" autoplay playsinline muted></video>
</div>

<div class="mt-3 text-sm text-slate-600">
Point your camera at the VIN barcode (often Code 39). If scanning fails, you can still type the VIN manually.
</div>
<div x-show="vinCameraError" x-cloak class="mt-2 text-sm text-red-700" x-text="vinCameraError"></div>

<div class="mt-3">
<label class="text-xs font-semibold text-slate-600">Detected VIN</label>
<input class="mt-1 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-slate-900"
x-model="vinCandidate" placeholder="—"/>
<div x-show="vinScanError" x-cloak class="mt-2 text-sm text-red-700" x-text="vinScanError"></div>
</div>

<div class="mt-4 flex flex-col sm:flex-row sm:justify-end gap-2">
<button type="button"
class="w-full sm:w-auto h-11 px-5 rounded-2xl bg-white border border-slate-300 text-slate-900 font-semibold hover:bg-slate-50"
@click="closeVINScanner()">Cancel</button>
<button type="button"
class="w-full sm:w-auto h-11 px-5 rounded-2xl bg-black text-white font-semibold hover:bg-slate-900 disabled:opacity-60"
:disabled="!(vinCandidate || '').trim()"
@click="confirmScannedVIN()">Use VIN</button>
</div>
</div>
</div>

											<div class="relative" @click.outside="makeOpen=false">
												<label class="text-sm font-medium text-slate-700">Make</label>
												<input class="mt-1 w-full rounded-2xl border border-slate-200 px-4 py-3"
													x-model="form.make"
													@focus="onMakeFocus()"
													@input="onMakeInput($event.target.value)"
													@keydown.escape="makeOpen=false"
													placeholder="Toyota"/>
												<div x-show="makeOpen" x-cloak class="absolute z-50 mt-2 w-full rounded-2xl border border-slate-200 bg-white shadow-lg overflow-hidden max-h-56 overflow-y-auto">
													<template x-for="m in makeSuggestions" :key="m">
														<button type="button" class="w-full text-left px-4 py-3 hover:bg-slate-50" @click="selectMake(m)">
															<span x-text="m"></span>
														</button>
													</template>
												</div>
											</div>

											<div class="relative" @click.outside="modelOpen=false">
												<label class="text-sm font-medium text-slate-700">Model</label>
												<input class="mt-1 w-full rounded-2xl border border-slate-200 px-4 py-3"
													x-model="form.model"
													@focus="onModelFocus()"
													@input="onModelInput($event.target.value)"
													@keydown.escape="modelOpen=false"
													placeholder="Camry"/>
												<div x-show="modelOpen" x-cloak class="absolute z-50 mt-2 w-full rounded-2xl border border-slate-200 bg-white shadow-lg overflow-hidden max-h-56 overflow-y-auto">
													<template x-for="m in modelSuggestions" :key="m">
														<button type="button" class="w-full text-left px-4 py-3 hover:bg-slate-50" @click="selectModel(m)">
															<span x-text="m"></span>
														</button>
													</template>
												</div>
											</div>

											<div>
												<label class="text-sm font-medium text-slate-700">Trim (optional)</label>
												<input class="mt-1 w-full rounded-2xl border border-slate-200 px-4 py-3" x-model="form.trim" placeholder="XLE"/>
											</div>
											<div>
												<label class="text-sm font-medium text-slate-700">Color (optional)</label>
												<input class="mt-1 w-full rounded-2xl border border-slate-200 px-4 py-3" x-model="form.color" placeholder="Blue"/>
											</div>
											<div class="md:col-span-2">
												<label class="text-sm font-medium text-slate-700">Plate (optional)</label>
												<input class="mt-1 w-full rounded-2xl border border-slate-200 px-4 py-3" x-model="form.plate" placeholder="ABC-123"/>
											</div>
										</div>

										<div x-show="error" x-cloak class="mt-4 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-red-800" x-text="error"></div>

										<div class="mt-6 flex flex-col sm:flex-row sm:justify-end gap-2">
											<button class="w-full sm:w-auto h-11 px-5 rounded-2xl bg-white border border-slate-300 text-slate-900 font-semibold hover:bg-slate-50" @click="closeModal()">Cancel</button>
											<button class="w-full sm:w-auto h-11 px-5 rounded-2xl bg-black text-white font-semibold hover:bg-slate-900 disabled:opacity-60"
												:disabled="saving"
												@click="save()">
												<span x-text="saving ? 'Saving…' : 'Save'"></span>
											</button>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>

					<div class="flex flex-col gap-6">
						<div class="rounded-3xl bg-white border border-slate-200 shadow-sm overflow-hidden">
							<div class="p-6 sm:p-8">
								<h2 class="text-2xl font-semibold tracking-tight text-slate-900">Membership</h2>
								<p class="mt-1 text-sm text-slate-500">Your current plan and included features.</p>

								<div class="mt-6 rounded-2xl border border-slate-200 p-5">
									<p class="text-slate-900 font-bold text-xl" x-text="subscription?.plan?.name || '—'"></p>
									<p class="text-slate-500 text-sm mt-1" x-text="subscription ? `$${subscription.plan.price}/mo` : ''"></p>

									<div class="mt-5">
										<p class="text-slate-700 text-sm font-semibold">Features</p>
										<ul class="mt-3 space-y-2 text-slate-600 text-sm">
											<template x-for="f in (subscription?.plan?.features || [])" :key="f">
												<li class="flex gap-2">
													<span class="material-symbols-outlined text-base text-emerald-600">check_circle</span>
													<span x-text="f"></span>
												</li>
											</template>
										</ul>
									</div>

									<a href="/choose-plan" class="mt-6 w-full h-11 rounded-2xl bg-black hover:bg-slate-900 text-white font-semibold flex items-center justify-center gap-2">
										<span class="material-symbols-outlined">sync</span>
										Change plan
									</a>
								</div>
							</div>
						</div>

						<div class="rounded-3xl bg-white border border-slate-200 shadow-sm overflow-hidden">
							<div class="p-6 sm:p-8">
								<h2 class="text-2xl font-semibold tracking-tight text-slate-900">Security</h2>
								<p class="mt-1 text-sm text-slate-500">Extra protection settings (UI only for now).</p>

								<div class="mt-6 space-y-3">
									<div class="rounded-2xl border border-slate-200 p-4 flex items-center justify-between gap-4">
										<div class="min-w-0">
											<p class="text-slate-900 font-semibold">Two-factor authentication</p>
											<p class="text-slate-500 text-sm">Add an extra layer of security to your account.</p>
										</div>
										<span class="text-slate-400 text-sm font-semibold">Coming soon</span>
									</div>

									<div class="rounded-2xl border border-slate-200 p-4 flex items-center justify-between gap-4">
										<div class="min-w-0">
											<p class="text-slate-900 font-semibold">Active sessions</p>
											<p class="text-slate-500 text-sm">Review and sign out other devices.</p>
										</div>
										<span class="text-slate-400 text-sm font-semibold">Coming soon</span>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<footer class="mt-12 border-t border-slate-200 pt-8 text-center text-sm text-slate-500">
					<div>© 2024 Hedgestone Carwash. All rights reserved.</div>
					<div class="mt-2 flex justify-center gap-4">
						<a class="text-slate-600 hover:text-slate-900 hover:underline" href="/terms">Terms</a>
						<a class="text-slate-600 hover:text-slate-900 hover:underline" href="/privacy">Privacy</a>
						<a class="text-slate-600 hover:text-slate-900 hover:underline" href="/contact">Support</a>
					</div>
				</footer>
			</div>
		</div>

		<style>
			[x-cloak] { display: none !important; }
		</style>
	}
}
