package users

import . "github.com/edlingao/hexago/web/views"

type DashboardVM struct {
	Error error
}

templ Dashboard(vm DashboardVM) {
	@UserShell(UserShellVM{
		Title: "Dashboard - Hedgestone Carwash",
		Error: vm.Error,
	}) {
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
		<div class="min-h-screen bg-slate-100 text-slate-900" x-data="dashboardStore()" x-init="$data.init?.()">
			<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-8">
				@DashboardHeader("dashboard")
				<section class="mt-10">
					<div class="flex flex-col gap-2">
						<div class="text-4xl font-semibold tracking-tight" x-text="welcomeMessage">Welcome back!</div>
						<div class="text-slate-500">Here is an overview of your carwash subscription.</div>
					</div>
				</section>

				<div class="mt-8 grid grid-cols-1 lg:grid-cols-3 gap-6">
					<div class="lg:col-span-2 flex flex-col gap-4">
							<div class="rounded-3xl bg-white border border-slate-200 shadow-sm overflow-hidden">
								<div class="p-8">
									<div class="flex items-start justify-between gap-10">
										<div class="flex items-start gap-6">
											<div class="h-16 w-16 rounded-2xl bg-amber-50 flex items-center justify-center">
												<span class="material-symbols-outlined text-amber-600 text-3xl">workspace_premium</span>
											</div>

											<div class="min-w-0">
												<div class="text-3xl font-semibold tracking-tight text-slate-900" x-text="planName">Platinum Unlimited</div>

												<div class="mt-3 flex items-center gap-4">
													<span class="inline-flex items-center gap-2 rounded-full bg-emerald-50 text-emerald-700 px-4 py-2 text-sm font-semibold border border-emerald-100">
														<span class="h-2 w-2 rounded-full bg-emerald-500"></span>
														<span x-text="planStatusLabel">Active</span>
													</span>
													<div class="text-slate-500 font-medium leading-relaxed" x-text="planRenewsLabel">Renews on —</div>
												</div>
											</div>
										</div>

										<div class="h-40 w-40 rounded-3xl bg-gradient-to-b from-amber-400 to-amber-600 shadow-md flex items-center justify-center shrink-0">
											<span class="material-symbols-outlined text-white text-6xl">star</span>
										</div>
									</div>

									<div class="mt-8 grid grid-cols-1 md:grid-cols-3">
										<div class="pl-4 border-l-4 border-amber-500">
											<div class="text-slate-500 font-medium leading-relaxed">Monthly Washes</div>
											<div class="mt-2 text-4xl font-black tracking-tight leading-none text-slate-900" x-text="monthlyWashesLabel">Unlimited</div>
										</div>

										<div class="mt-6 md:mt-0 md:px-10 md:border-l md:border-slate-200">
											<div class="text-slate-500 font-medium leading-relaxed">This Month</div>
											<div class="mt-2 flex items-baseline gap-2">
												<div class="text-4xl font-black tracking-tight leading-none text-slate-900" x-text="thisMonthWashCount ?? '—'">12</div>
												<div class="text-2xl font-semibold text-slate-400">washes</div>
											</div>
										</div>

										<div class="mt-6 md:mt-0 md:px-10 md:border-l md:border-slate-200">
											<div class="text-slate-500 font-medium leading-relaxed">Member Since</div>
											<div class="mt-2 text-4xl font-black tracking-tight leading-none text-slate-900" x-text="memberSinceLabel">Jan 2024</div>
										</div>
									</div>

									<div class="mt-10 flex flex-wrap gap-5">
										<a href="/choose-plan" class="h-11 px-7 rounded-2xl bg-black text-white font-black flex items-center gap-3 shadow-sm">
											<span class="material-symbols-outlined">settings</span>
											Manage Subscription
										</a>
									</div>
								</div>
							</div>

							<div class="rounded-3xl bg-white border border-slate-200 shadow-sm overflow-hidden">
								<div class="p-8">
									<div class="flex items-center justify-between">
										<h2 class="text-xl font-semibold tracking-tight text-slate-900">Recent Washes</h2>
										<a href="/history" class="inline-flex items-center gap-2 text-sm font-semibold text-amber-700 hover:text-amber-800">
											View All
											<span class="material-symbols-outlined">arrow_right_alt</span>
										</a>
									</div>

									<div class="mt-6 rounded-2xl border border-slate-100 bg-slate-50/50 p-5">
									<div class="flex flex-col gap-4">
										<template x-for="wash in recentWashes" :key="wash.id">
											<div class="rounded-2xl bg-white border border-slate-200/60 shadow-sm p-4">
												<div class="flex items-center justify-between gap-6">
													<div class="flex items-center gap-6 min-w-0">
														<div class="h-12 w-12 rounded-xl bg-black flex items-center justify-center shrink-0">
															<span class="material-symbols-outlined text-amber-400 text-xl"
																x-text="wash.result === 'allowed' ? 'check' : 'close'"></span>
														</div>

														<div class="min-w-0">
															<div class="text-base font-semibold text-slate-900 truncate" x-text="wash.washType"></div>

															<div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2 text-slate-500 font-medium text-xs leading-normal">
																<div class="inline-flex items-center gap-2">
																	<span class="material-symbols-outlined text-slate-400 text-base">calendar_month</span>
																	<span x-text="formatWashDate(wash.date)"></span>
																</div>

																<div class="inline-flex items-center gap-2">
																	<span class="material-symbols-outlined text-slate-400 text-base">schedule</span>
																	<span x-text="wash.time"></span>
																</div>

																<div class="inline-flex items-center gap-2 min-w-0">
																	<span class="material-symbols-outlined text-slate-400 text-base">location_on</span>
																	<span class="truncate"
																		x-text="(wash.location && wash.location.name ? wash.location.name : '') + ((wash.location && wash.location.address) ? ' - ' + wash.location.address : '')"></span>
																</div>
															</div>
														</div>
													</div>

													<span class="px-3 py-1 rounded-full text-xs font-semibold shrink-0"
														:class="wash.result === 'allowed' ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700'"
														x-text="wash.result === 'allowed' ? 'Completed' : 'Denied'"></span>
												</div>
											</div>
										</template>

										<div x-show="recentWashes.length === 0" class="rounded-2xl bg-white border border-slate-200 p-8 text-center text-slate-500">
											No recent washes found.
										</div>
									</div>
									</div>
								</div>
							</div>
					</div>
					<div class="rounded-3xl bg-white border border-slate-200 shadow-sm overflow-hidden">
	<div class="p-8">
		<h3 class="text-xl font-semibold tracking-tight text-slate-900">Your Wash Access Code</h3>
		<p class="mt-2 text-sm text-slate-500">Present this code at the carwash entrance to start your wash.</p>

		<div class="mt-6 rounded-2xl bg-slate-900 p-6 flex flex-col items-center">
			<a href="/qr-code" class="block rounded-2xl bg-white p-3">
				<img x-show="accessQrUrl" class="rounded-xl w-48 h-48" :src="accessQrUrl" alt="QR code for car wash access"/>
			</a>
			<div class="mt-4 text-xs text-slate-300">Scan at any Hedgestone Carwash location</div>
		</div>

		<div class="mt-6 space-y-3">
			<a href="/qr-code" class="w-full h-11 rounded-xl bg-black hover:bg-slate-800 text-white font-semibold flex items-center justify-center gap-2">
				<span class="material-symbols-outlined">qr_code_2</span>
				View Full Code
			</a>

			<button @click="printCode" class="w-full h-11 rounded-xl bg-white hover:bg-slate-50 border border-slate-300 text-slate-900 font-semibold flex items-center justify-center gap-2">
				<span class="material-symbols-outlined">print</span>
				Print Code
			</button>
		</div>
	</div>
</div>
				</div>

				<footer class="mt-12 border-t border-slate-200 pt-8 text-center text-sm text-slate-500">
					<div>© 2024 Hedgestone Carwash. All rights reserved.</div>
					<div class="mt-2 flex justify-center gap-4">
						<a class="text-slate-600 hover:text-slate-900 hover:underline" href="/terms">Terms</a>
						<a class="text-slate-600 hover:text-slate-900 hover:underline" href="/privacy">Privacy</a>
						<a class="text-slate-600 hover:text-slate-900 hover:underline" href="/contact">Support</a>
					</div>
				</footer>
			</div>
		</div>
	}
}
