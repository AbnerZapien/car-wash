package users

import . "github.com/edlingao/hexago/web/views"

type DashboardVM struct {
	Error error
}

templ Dashboard(vm DashboardVM) {
	@UserShell(UserShellVM{
		Title: "Dashboard - Hedgestone Carwash",
		Error: vm.Error,
	}) {
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
		<div class="min-h-screen bg-slate-100 text-slate-900" x-data="dashboardStore()" x-init="$data.init && $data.init()">
			<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-8">
				@DashboardHeader("dashboard")
				<section class="mt-10">
					<div class="flex flex-col gap-2">
						<div class="text-4xl font-semibold tracking-tight" x-text="welcomeMessage">Welcome back!</div>
						<div class="text-white/60">Here is an overview of your carwash subscription.</div>
					</div>
				</section>

				<div class="mt-8 grid grid-cols-1 lg:grid-cols-3 gap-6">
					<div class="lg:col-span-2 flex flex-col gap-6">
							<div class="rounded-3xl bg-white border border-slate-200 shadow-sm overflow-hidden">
								<div class="p-8">
									<div class="flex items-start justify-between gap-10">
										<div class="flex items-start gap-6">
											<div class="h-16 w-16 rounded-2xl bg-amber-50 flex items-center justify-center">
												<span class="material-symbols-outlined text-amber-600 text-3xl">workspace_premium</span>
											</div>

											<div class="min-w-0">
												<div class="text-4xl font-black tracking-tight text-slate-900" x-text="planName">Platinum Unlimited</div>

												<div class="mt-3 flex items-center gap-4">
													<span class="inline-flex items-center gap-2 rounded-full bg-emerald-50 text-emerald-700 px-4 py-2 text-sm font-semibold border border-emerald-100">
														<span class="h-2 w-2 rounded-full bg-emerald-500"></span>
														<span x-text="planStatusLabel">Active</span>
													</span>
													<div class="text-slate-500 font-medium" x-text="planRenewsLabel">Renews on —</div>
												</div>
											</div>
										</div>

										<div class="h-40 w-40 rounded-3xl bg-gradient-to-b from-amber-400 to-amber-600 shadow-md flex items-center justify-center shrink-0">
											<span class="material-symbols-outlined text-white text-6xl">star</span>
										</div>
									</div>

									<div class="mt-8 grid grid-cols-1 md:grid-cols-3">
										<div class="pl-4 border-l-4 border-amber-500">
											<div class="text-slate-500 font-semibold">Monthly Washes</div>
											<div class="mt-2 text-5xl font-black tracking-tight text-slate-900" x-text="monthlyWashesLabel">Unlimited</div>
										</div>

										<div class="mt-6 md:mt-0 md:px-10 md:border-l md:border-slate-200">
											<div class="text-slate-500 font-semibold">This Month</div>
											<div class="mt-2 flex items-baseline gap-2">
												<div class="text-5xl font-black tracking-tight text-slate-900" x-text="thisMonthWashCount ?? '—'">12</div>
												<div class="text-2xl font-semibold text-slate-400">washes</div>
											</div>
										</div>

										<div class="mt-6 md:mt-0 md:px-10 md:border-l md:border-slate-200">
											<div class="text-slate-500 font-semibold">Member Since</div>
											<div class="mt-2 text-5xl font-black tracking-tight text-slate-900" x-text="memberSinceLabel">Jan 2024</div>
										</div>
									</div>

									<div class="mt-10 flex flex-wrap gap-5">
										<button @click="manageSubscription" class="h-14 px-10 rounded-2xl bg-black text-white font-black flex items-center gap-3 shadow-sm">
											<span class="material-symbols-outlined">settings</span>
											Manage Subscription
										</button>

										<button @click="viewHistory" class="h-14 px-10 rounded-2xl bg-white text-slate-900 font-black border-2 border-slate-900 flex items-center gap-3">
											<span class="material-symbols-outlined">history</span>
											Wash History
										</button>
									</div>
								</div>
							</div>

						<div class="rounded-2xl bg-white/5 border border-white/10 p-6">
							<div class="flex items-center justify-between">
								<h2 class="text-xl font-semibold">Recent Washes</h2>
								<a href="/history" class="text-sm text-white/70 hover:text-white">See all</a>
							</div>

							<div class="mt-4 flex flex-col gap-3">
								<template x-for="wash in recentWashes" :key="wash.id">
									<div class="flex items-center justify-between rounded-xl bg-black/30 border border-white/10 p-4">
										<div class="flex items-center gap-4 min-w-0">
											<div class="flex h-11 w-11 items-center justify-center rounded-full bg-[#2F6BFF]/15 text-[#89A8FF] border border-[#2F6BFF]/20">
												<span class="material-symbols-outlined">directions_car</span>
											</div>

											<div class="min-w-0">
												<div class="flex items-center gap-2 min-w-0">
													<span class="px-2.5 py-1 text-xs font-semibold rounded-full shrink-0 border"
														:class="wash.result === 'allowed' ? 'bg-emerald-500/15 text-emerald-200 border-emerald-500/20' : 'bg-red-500/15 text-red-200 border-red-500/20'"
														x-text="wash.result === 'allowed' ? 'Allowed' : 'Denied'"></span>
													<p class="font-semibold truncate" x-text="wash.washType"></p>
												</div>
												<p class="text-sm text-white/60 truncate" x-text="wash.location.name"></p>
											</div>
										</div>

										<div class="text-right shrink-0">
											<p class="text-white/90 font-medium" x-text="formatWashDate(wash.date)"></p>
											<p class="text-sm text-white/60" x-text="wash.time"></p>
										</div>
									</div>
								</template>

								<div x-show="recentWashes.length === 0" class="rounded-xl bg-black/30 border border-white/10 p-8 text-center text-white/60">
									No recent washes found.
								</div>
							</div>
						</div>
					</div>

					<div class="rounded-2xl bg-white/5 border border-white/10 p-6 flex flex-col items-center justify-center gap-4">
						<div class="text-xs uppercase tracking-widest text-white/60">Access</div>
						<h3 class="text-xl font-semibold">Your Wash Code</h3>
						<p class="text-white/60 text-center text-sm">Present this code at the carwash entrance to start your wash.</p>

						<div class="p-4 rounded-xl bg-black/30 border border-white/10">
							<a href="/qr-code">
								<img class="rounded-lg w-48 h-48" :src="accessQrUrl" alt="QR code for car wash access"/>
							</a>
						</div>

						<a href="/qr-code" class="w-full h-11 rounded-xl bg-[#2F6BFF] hover:bg-[#295FE0] text-white font-semibold flex items-center justify-center gap-2">
							<span class="material-symbols-outlined">qr_code_2</span>
							View Full Code
						</a>

						<button @click="printCode" class="w-full h-11 rounded-xl bg-white/10 hover:bg-white/15 border border-white/10 text-white font-semibold flex items-center justify-center gap-2">
							<span class="material-symbols-outlined">print</span>
							Print Code
						</button>
					</div>
				</div>

				<footer class="mt-12 border-t border-white/10 pt-8 text-center text-sm text-white/50">
					<div>© 2024 Hedgestone Carwash. All rights reserved.</div>
					<div class="mt-2 flex justify-center gap-4">
						<a class="text-[#89A8FF] hover:underline" href="/terms">Terms</a>
						<a class="text-[#89A8FF] hover:underline" href="/privacy">Privacy</a>
						<a class="text-[#89A8FF] hover:underline" href="/contact">Support</a>
					</div>
				</footer>
			</div>
		</div>
	}
}
