package users

import . "github.com/edlingao/hexago/web/views"

type HistoryVM struct {
	Error error
}

templ History(vm HistoryVM) {
	@UserShell(UserShellVM{Title: "History - Hedgestone Carwash", Error: vm.Error}) {
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
		<div class="min-h-screen bg-slate-100 text-slate-900 overflow-x-hidden" x-data="historyStore()" x-init="init()">
			<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-8">
				@DashboardHeader("history")

				<section class="mt-10">
					<div class="flex flex-col gap-2">
						<div class="text-4xl font-semibold tracking-tight text-slate-900">Wash History</div>
						<div class="text-slate-500">Recent activity for your membership.</div>
					</div>
				</section>

				<div class="mt-8">
					<div class="rounded-3xl bg-white border border-slate-200 shadow-sm overflow-hidden">
						<div class="p-6 sm:p-8">
							<div class="flex items-center justify-between gap-3">
								<h2 class="text-xl font-semibold tracking-tight text-slate-900">Recent Washes</h2>
								<p class="text-sm text-slate-500" x-text="washHistory?.length ? `${washHistory.length} record(s)` : 'No records'"></p>
							</div>

							<div class="mt-6 rounded-2xl border border-slate-100 bg-slate-50/50 p-5">
								<div class="flex flex-col gap-4">
									<template x-if="!washHistory || washHistory.length === 0">
										<div class="rounded-2xl bg-white border border-slate-200 p-8 text-center text-slate-500">
											No history found.
										</div>
									</template>

									<template x-for="w in washHistory" :key="w.id">
										<div class="rounded-2xl bg-white border border-slate-200/60 shadow-sm p-4">
											<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 sm:gap-6">
												<div class="flex items-center gap-4 min-w-0">
													<div class="h-12 w-12 rounded-xl bg-black flex items-center justify-center shrink-0">
														<span class="material-symbols-outlined text-amber-400 text-xl" x-text="w.result === 'allowed' ? 'check' : 'close'"></span>
													</div>

													<div class="min-w-0">
														<div class="text-lg sm:text-base font-semibold text-slate-900 truncate" x-text="w.washType"></div>

														<div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2 text-slate-500 font-medium text-sm sm:text-xs leading-normal">
															<div class="inline-flex items-center gap-2">
																<span class="material-symbols-outlined text-slate-400 text-lg sm:text-base">calendar_month</span>
																<span x-text="formatWashDate(w.date)"></span>
															</div>

															<div class="inline-flex items-center gap-2">
																<span class="material-symbols-outlined text-slate-400 text-lg sm:text-base">schedule</span>
																<span x-text="w.time"></span>
															</div>

															<div class="inline-flex items-center gap-2 min-w-0">
																<span class="material-symbols-outlined text-slate-400 text-lg sm:text-base">location_on</span>
																<span class="truncate" x-text="(w.location && w.location.name ? w.location.name : '') + ((w.location && w.location.address) ? ' - ' + w.location.address : '')"></span>
															</div>
														</div>

														<p class="mt-2 text-sm sm:text-xs text-slate-500" x-show="w.result !== 'allowed' && w.reason" x-text="`Reason: ${w.reason}`" x-cloak></p>
													</div>
												</div>

												<span class="px-3 py-1.5 rounded-full text-sm sm:text-xs font-semibold shrink-0 self-start sm:self-auto"
													:class="w.result === 'allowed' ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700'"
													x-text="w.result === 'allowed' ? 'Completed' : 'Denied'"></span>
											</div>
										</div>
									</template>
								</div>
							</div>

							<div class="mt-6 text-center text-slate-500 text-sm">
								Need help? <a class="text-blue-600 hover:underline" href="/contact">Contact support</a>.
							</div>
						</div>
					</div>
				</div>

				<footer class="mt-12 border-t border-slate-200 pt-8 text-center text-sm text-slate-500">
					<div>© 2024 Hedgestone Carwash. All rights reserved.</div>
					<div class="mt-2 flex justify-center gap-4">
						<a class="text-slate-600 hover:text-slate-900 hover:underline" href="/terms">Terms</a>
						<a class="text-slate-600 hover:text-slate-900 hover:underline" href="/privacy">Privacy</a>
						<a class="text-slate-600 hover:text-slate-900 hover:underline" href="/contact">Support</a>
					</div>
				</footer>
			</div>

			<style>
				[x-cloak] { display: none !important; }
			</style>
		</div>
	}
}
